# IMYAP Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Apple Music API Configuration
# Get your credentials from: https://developer.apple.com/
# APPLE_MUSIC_API_KEY=your_apple_music_api_key_here
# APPLE_MUSIC_TEAM_ID=your_team_id_here
# APPLE_MUSIC_KEY_ID=your_key_id_here

# Spotify API Configuration
# Get your credentials from: https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# SPOTIFY_REDIRECT_URI=imyap://callback

# API Environment
# API_ENV=development
# API_BASE_URL=https://api.example.com

# Feature Flags
# ENABLE_ANALYTICS=false
# ENABLE_ERROR_REPORTING=false

# Debug Mode
# DEBUG_MODE=false
