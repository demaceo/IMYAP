// Prisma schema for IMYAP backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  spotifyId         String?  @unique
  spotifyToken      String?
  spotifyRefresh    String?
  spotifyExpiry     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  conversions       Conversion[]
}

model Conversion {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  sourcePlatform String  // "spotify" | "apple"
  targetPlatform String  // "spotify" | "apple"
  sourceUrl     String
  targetUrl     String?
  status        String   // "pending" | "success" | "error"
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
